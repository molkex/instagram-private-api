# Instagram & Threads Mobile Private API Configuration

# Commercial API Key or Standalone Daemon Key
INSTAGRAM_API_KEY=ig_live_your_api_key_here

# Hardware Preset (iphone_15_pro, iphone_15_pro_max, pixel_8_pro, galaxy_s24_ultra, galaxy_a34_5g)
INSTAGRAM_DEVICE_PRESET=iphone_15_pro

# Signing Server URL (hosted cloud endpoint or local standalone daemon)
INSTAGRAM_SIGNING_SERVER=http://127.0.0.1:8643

# Mobile / Residential Proxy (HTTP or SOCKS5)
# INSTAGRAM_PROXY=socks5://user:password@proxy-node.mobile-carrier.com:1080

# Authenticated session token (optional if logging in programmatically)
# INSTAGRAM_SESSION_TOKEN=your_saved_session_token
